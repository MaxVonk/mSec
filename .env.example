# mSec Environment Configuration

PORT=3310
NODE_ENV=production


# Microsoft Graph / Defender XDR Credentials (populated automatically by ./setup-entra.sh)
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Optional Microsoft Sentinel SIEM Credentials
SENTINEL_SUBSCRIPTION_ID=
SENTINEL_RESOURCE_GROUP=
SENTINEL_WORKSPACE_NAME=

# PhishPilot - Monitored Mailbox for suspicious email reports (.eml)
PHISHPILOT_MAILBOX=phish-reports@vermiculus.se

# PhishPilot - Azure OpenAI (optional, enables AI classification)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_MINI=gpt-4o-mini
AZURE_OPENAI_DEPLOYMENT_FULL=gpt-4o

# PhishPilot - Threat Intelligence (optional, improves accuracy)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_KEY=
GOOGLE_SAFEBROWSING_KEY=

