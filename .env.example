# mSec Environment Configuration

PORT=3310
NODE_ENV=production

# ── App URL ───────────────────────────────────────────────
# Public base URL — used for the Microsoft OAuth redirect URI
APP_URL=https://security.example.com

# ─── Certbot / TLS ─────────────────────────────────────────
# Domain name for the Let's Encrypt certificate (used by nginx and ./init-letsencrypt.sh).
DOMAIN=security.example.com
# Email address for Let's Encrypt registration (used by ./init-letsencrypt.sh).
CERTBOT_EMAIL=admin@example.com
# Set to 'false' to request a live certificate; keep 'true' while testing.
CERTBOT_STAGING=false
# ACME challenge method: 'http' (requires inbound port 80) or 'dns' (works for internal-only deployments).
CERTBOT_CHALLENGE_METHOD=dns
# Optional override for Certbot image (for DNS challenge set to provider plugin image if needed).
# Example: certbot/dns-cloudflare:latest
CERTBOT_IMAGE=certbot/dns-cloudflare:latest
# DNS challenge provider slug (required when CERTBOT_CHALLENGE_METHOD=dns), e.g. cloudflare, route53, digitalocean.
CERTBOT_DNS_PROVIDER=cloudflare
# Path to DNS credentials file under ./certbot/creds (required when CERTBOT_CHALLENGE_METHOD=dns).
# Leave empty to use ./certbot/creds/<CERTBOT_DNS_PROVIDER>.ini
CERTBOT_DNS_CREDENTIALS_FILE=./certbot/creds/cloudflare.ini
# DNS propagation wait time in seconds.
CERTBOT_DNS_PROPAGATION_SECONDS=60

# ─── Microsoft Entra ID / Graph / Defender XDR ─────────────
# Populated automatically by ./setup-entra.sh or entered manually
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
AUTH_REDIRECT_URI=

# ─── Microsoft Sentinel SIEM ───────────────────────────────
SENTINEL_SUBSCRIPTION_ID=
SENTINEL_RESOURCE_GROUP=
SENTINEL_WORKSPACE_NAME=

# ─── PhishPilot Mailbox Monitoring ────────────────────────
PHISHPILOT_MAILBOX=phish-reports@example.com

# ─── Azure OpenAI (Optional AI Triage) ────────────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_MINI=gpt-4o-mini
AZURE_OPENAI_DEPLOYMENT_FULL=gpt-4o

# ─── Threat Intelligence (Optional Reputation Enrichment) ──
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
ABUSEIPDB_KEY=
OTX_API_KEY=
GOOGLE_SAFEBROWSING_KEY=

# ─── Notification Webhooks (Optional) ─────────────────────
TEAMS_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
CUSTOM_WEBHOOK_URL=
