# Cloudflare API token credentials for Certbot DNS challenge
# Instructions:
# 1. Create a Cloudflare API Token with "Zone:DNS:Edit" and "Zone:Zone:Read" permissions
# 2. Copy this file to ./certbot/creds/cloudflare.ini
# 3. Replace the token below with your Cloudflare API token
# 4. Secure the file: chmod 600 ./certbot/creds/cloudflare.ini

dns_cloudflare_api_token = 0123456789abcdef0123456789abcdef01234567
