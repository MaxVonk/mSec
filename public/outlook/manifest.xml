<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp 
          xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" 
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
          xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" 
          xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0" 
          xsi:type="MailApp">
  <Id>91ff2e5b-5a26-4e49-8d67-c992535dcfdc</Id>
  <Version>1.0.0.2</Version>
  <ProviderName>mSec PhishPilot</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="PhishPilot Security Reporter" />
  <Description DefaultValue="1-Click AI-Powered Phishing Threat Analysis and Reporting for Microsoft Outlook." />
  <IconUrl DefaultValue="https://raw.githubusercontent.com/MaxVonk/mSec/main/public/outlook/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="https://raw.githubusercontent.com/MaxVonk/mSec/main/public/outlook/icon-128.png" />
  <SupportUrl DefaultValue="https://security.example.com" />
  <AppDomains>
    <AppDomain>https://security.example.com</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.3" />
    </Sets>
  </Requirements>

  <!-- Legacy Outlook (Pre-2016) Form Settings -->
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://security.example.com/outlook/taskpane.html" />
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <!-- Modern Outlook (Web, New Outlook for Windows, Mac) VersionOverrides -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <!-- Ribbon and Message Read Command Surface -->
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgReadGroup">
                <Label resid="groupLabel" />
                <Control xsi:type="Button" id="msgReadOpenPaneButton">
                  <Label resid="buttonLabel" />
                  <Supertip>
                    <Title resid="superTipTitle" />
                    <Description resid="superTipDescription" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16" />
                    <bt:Image size="32" resid="icon32" />
                    <bt:Image size="80" resid="icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="taskpaneUrl" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="icon16" DefaultValue="https://raw.githubusercontent.com/MaxVonk/mSec/main/public/outlook/icon-16.png" />
        <bt:Image id="icon32" DefaultValue="https://raw.githubusercontent.com/MaxVonk/mSec/main/public/outlook/icon-32.png" />
        <bt:Image id="icon80" DefaultValue="https://raw.githubusercontent.com/MaxVonk/mSec/main/public/outlook/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="taskpaneUrl" DefaultValue="https://security.example.com/outlook/taskpane.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="groupLabel" DefaultValue="Security" />
        <bt:String id="buttonLabel" DefaultValue="Report Phish (PhishPilot)" />
        <bt:String id="superTipTitle" DefaultValue="PhishPilot Security Reporter" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="superTipDescription" DefaultValue="Scan, analyze, and report suspicious phishing emails with PhishPilot AI." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
